<resources>
    <style name="Theme.Cubox" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:alertDialogTheme">@style/Theme.Cubox.Dialog</item>
        <item name="android:colorAccent">#E50914</item>
        <item name="android:windowBackground">#080808</item>
        <item name="android:colorBackground">#080808</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#A3A3A3</item>
        <item name="android:statusBarColor">#080808</item>
        <item name="android:navigationBarColor">#080808</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Cubox.Dialog" parent="Theme.Cubox.Dialog.Base" />
    <style name="Theme.Cubox.Dialog.Base" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog</item>
        <item name="android:colorBackground">#15161E</item>
        <item name="android:colorAccent">#FF6672</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#E2E2EB</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowElevation">16dp</item>
        <item name="android:colorControlHighlight">#40FFFFFF</item>
    </style>
</resources>
